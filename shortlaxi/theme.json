{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Midnight",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"customGradient": false,
			"palette": [
				{ "slug": "base", "name": "Midnight", "color": "#0B1020" },
				{ "slug": "base-2", "name": "Sidebar", "color": "#111827" },
				{ "slug": "surface", "name": "Card", "color": "#172033" },
				{ "slug": "surface-2", "name": "Card hover", "color": "#1F2A40" },
				{ "slug": "contrast", "name": "Text", "color": "#F9FAFB" },
				{ "slug": "contrast-2", "name": "Secondary text", "color": "#9CA3AF" },
				{ "slug": "accent", "name": "Gold", "color": "#D4AF37" },
				{ "slug": "border", "name": "Divider", "color": "#243049" },
				{ "slug": "outline", "name": "Control outline", "color": "#6B7280" }
			]
		},
		"layout": {
			"contentSize": "46rem",
			"wideSize": "100rem"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "10", "name": "2X-Small", "size": "0.25rem" },
				{ "slug": "20", "name": "X-Small", "size": "0.5rem" },
				{ "slug": "30", "name": "Small", "size": "clamp(0.75rem, 2vw, 1rem)" },
				{ "slug": "40", "name": "Medium", "size": "clamp(1rem, 3vw, 1.5rem)" },
				{ "slug": "50", "name": "Large", "size": "clamp(1.5rem, 4vw, 2.5rem)" },
				{ "slug": "60", "name": "X-Large", "size": "clamp(2rem, 6vw, 4rem)" },
				{ "slug": "70", "name": "2X-Large", "size": "clamp(3rem, 8vw, 6rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"dropCap": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Interface Sans",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "serif",
					"name": "Reading Serif",
					"fontFamily": "Charter, \"Bitstream Charter\", \"Sitka Text\", Cambria, \"Iowan Old Style\", Georgia, serif"
				},
				{
					"slug": "mono",
					"name": "Monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Extra Small", "size": "0.8125rem", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Extra Large", "size": "1.625rem", "fluid": { "min": "1.375rem", "max": "1.875rem" } },
				{ "slug": "xx-large", "name": "2X Large", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.75rem" } },
				{ "slug": "huge", "name": "Huge", "size": "3rem", "fluid": { "min": "2.125rem", "max": "3.5rem" } }
			]
		},
		"custom": {
			"line-height": {
				"tight": "1.2",
				"snug": "1.35",
				"body": "1.6",
				"reading": "1.75"
			},
			"letter-spacing": {
				"kicker": "0.08em"
			},
			"radius": {
				"small": "8px",
				"medium": "12px",
				"large": "16px",
				"pill": "999px"
			},
			"shell": {
				"header-height": "3.5rem",
				"sidebar-width": "15rem",
				"rail-width": "4.75rem",
				"gutter": "clamp(1rem, 2.5vw, 1.5rem)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"left": "var(--wp--custom--shell--gutter)",
				"right": "var(--wp--custom--shell--gutter)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "var(--wp--custom--line-height--body)"
		},
		"elements": {
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				},
				":focus": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "700",
					"lineHeight": "var(--wp--custom--line-height--tight)",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "var(--wp--custom--line-height--snug)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "var(--wp--custom--line-height--snug)" } },
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"letterSpacing": "var(--wp--custom--letter-spacing--kicker)",
					"textTransform": "uppercase"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"letterSpacing": "var(--wp--custom--letter-spacing--kicker)",
					"textTransform": "uppercase"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "var(--wp--custom--radius--pill)", "width": "0" },
				"spacing": {
					"padding": {
						"top": "0.625rem",
						"bottom": "0.625rem",
						"left": "1.25rem",
						"right": "1.25rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"lineHeight": "1.2"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--contrast-2)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"lineHeight": "1.45"
				}
			},
			"cite": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontStyle": "normal"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontSize": "1.25rem",
					"fontWeight": "800",
					"letterSpacing": "-0.02em",
					"lineHeight": "1"
				},
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": {
							"color": { "text": "var(--wp--preset--color--contrast)" }
						}
					}
				}
			},
			"core/site-tagline": {
				"color": { "text": "var(--wp--preset--color--contrast-2)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500"
				},
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": {
							"color": { "text": "var(--wp--preset--color--contrast)" },
							"typography": { "textDecoration": "underline" }
						}
					}
				}
			},
			"core/post-terms": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"fontWeight": "700",
					"letterSpacing": "var(--wp--custom--letter-spacing--kicker)",
					"textTransform": "uppercase"
				},
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--accent)" },
						"typography": { "textDecoration": "none" },
						":hover": {
							"color": { "text": "var(--wp--preset--color--accent)" },
							"typography": { "textDecoration": "underline" }
						}
					}
				}
			},
			"core/post-date": {
				"color": { "text": "var(--wp--preset--color--contrast-2)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--x-small)" }
			},
			"core/post-author-name": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				}
			},
			"core/post-time-to-read": {
				"color": { "text": "var(--wp--preset--color--contrast-2)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--x-small)" }
			},
			"core/post-excerpt": {
				"color": { "text": "var(--wp--preset--color--contrast-2)" },
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.5"
				}
			},
			"core/post-content": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "1.1875rem",
					"lineHeight": "var(--wp--custom--line-height--reading)"
				},
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--accent)" },
						":hover": {
							"color": { "text": "var(--wp--preset--color--contrast)" }
						}
					}
				}
			},
			"core/post-author": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/post-author-biography": {
				"color": { "text": "var(--wp--preset--color--contrast-2)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/breadcrumbs": {
				"color": { "text": "var(--wp--preset--color--contrast-2)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--x-small)" }
			},
			"core/query-title": {
				"typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" }
			},
			"core/term-description": {
				"color": { "text": "var(--wp--preset--color--contrast-2)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)" }
			},
			"core/query-pagination": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				}
			},
			"core/post-navigation-link": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/search": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" },
				"border": { "radius": "var(--wp--custom--radius--pill)" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--border)" },
				"border": { "width": "1px 0 0 0" }
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--accent)",
						"width": "3px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": { "left": "var(--wp--preset--spacing--40)" }
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontStyle": "italic",
					"lineHeight": "var(--wp--custom--line-height--snug)"
				}
			},
			"core/pullquote": {
				"border": {
					"top": { "color": "var(--wp--preset--color--accent)", "width": "3px", "style": "solid" },
					"bottom": { "color": "var(--wp--preset--color--border)", "width": "1px", "style": "solid" }
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--40)",
						"bottom": "var(--wp--preset--spacing--40)",
						"left": "0",
						"right": "0"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "700",
					"lineHeight": "var(--wp--custom--line-height--tight)"
				}
			},
			"core/code": {
				"color": { "background": "var(--wp--preset--color--surface)" },
				"border": { "radius": "var(--wp--custom--radius--small)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--x-small)"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--30)",
						"bottom": "var(--wp--preset--spacing--30)",
						"left": "var(--wp--preset--spacing--30)",
						"right": "var(--wp--preset--spacing--30)"
					}
				}
			},
			"core/image": {
				"border": { "radius": "var(--wp--custom--radius--medium)" }
			},
			"core/post-featured-image": {
				"border": { "radius": "var(--wp--custom--radius--medium)" }
			},
			"core/table": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/footnotes": {
				"color": { "text": "var(--wp--preset--color--contrast-2)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page without title",
			"postTypes": [ "page" ]
		}
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "sidebar", "title": "Sidebar", "area": "uncategorized" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
