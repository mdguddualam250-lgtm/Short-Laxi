{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "shortlaxi/bookmarks",
	"title": "Bookmarked Articles",
	"category": "theme",
	"description": "Shows the articles a reader has bookmarked in this browser, loaded from the REST API.",
	"keywords": [ "saved", "bookmarks", "read later" ],
	"textdomain": "shortlaxi",
	"attributes": {
		"limit": { "type": "integer", "default": 0 },
		"hideWhenEmpty": { "type": "boolean", "default": false }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true },
		"interactivity": { "clientNavigation": true }
	},
	"editorScript": "shortlaxi-editor-blocks",
	"render": "file:./render.php"
}
